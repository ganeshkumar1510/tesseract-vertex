# ─────────────────────────────────────────────────────────────────────────────
# Tesseract Vertex — Environment Example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── System PINs (local / UAT only) ───────────────────────────────────────────
# VITE_* values are bundled into the client JavaScript — never treat them
# as server secrets, and never rely on them to protect production data.
VITE_ADMIN_PIN=1510

# ── API master key (login) ───────────────────────────────────────────────────
# REQUIRED in production (any non-placeholder value). When unset, development
# falls back to VITE_ADMIN_PIN; production fails closed (login disabled).
MASTER_PASSWORD=1510

# ── JWT sessions (required after login) ──────────────────────────────────────
# REQUIRED in production: template/placeholder values disable login there.
JWT_SECRET=change-me-to-a-long-random-string

# ── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API cross-origin.
# Same-origin deployments (the default) need no configuration.
CORS_ORIGINS=

# ── Database (optional) ──────────────────────────────────────────────────────
# Vertex is local-first: if no database is configured it runs in local-only
# mode (data stays in the browser). To enable cloud persistence, fill in the
# values below. Replace [YOUR-PASSWORD] with your real Supabase DB password.
#
# Prisma connection string:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# ── Supabase (client / API fallback) ─────────────────────────────────────────
# Used as the fallback connection + client when DATABASE_URL is not set.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-supabase-anon-key>"

# Legacy/Vite-prefixed aliases are also read by the app if present:
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
