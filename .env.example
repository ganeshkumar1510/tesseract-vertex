# ─────────────────────────────────────────────────────────────────────────────
# Tesseract Vertex — Environment Example
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── System PINs (local / UAT) ────────────────────────────────────────────────
VITE_ADMIN_PIN=1510
VITE_TEST_PIN=0000

# ── API master key (login) ───────────────────────────────────────────────────
# Defaults to VITE_ADMIN_PIN when unset.
MASTER_PASSWORD=1510

# ── JWT sessions (required after login) ──────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Database (optional) ──────────────────────────────────────────────────────
# Vertex is local-first: if no database is configured it runs in local-only
# mode (data stays in the browser). To enable cloud persistence, fill in the
# values below. Replace [YOUR-PASSWORD] with your real Supabase DB password.
#
# Prisma connection string:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# ── Supabase (client / API fallback) ─────────────────────────────────────────
# Used as the fallback connection + client when DATABASE_URL is not set.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-supabase-anon-key>"

# Legacy/Vite-prefixed aliases are also read by the app if present:
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-supabase-anon-key>"
